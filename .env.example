# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Required AT RUNTIME — the CMS and every public
# page read from it while the server is running.
#
# It is NOT needed to compile the app: `next build` completes without it,
# because no CMS-backed page is prerendered at build time. Migrations
# (`prisma migrate deploy`) do need it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/noriva?schema=public"

# ─── Authentication ──────────────────────────────────────────────────────────
# Signs admin session cookies. Must be at least 32 random characters.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=""

# ─── Initial admin account ───────────────────────────────────────────────────
# Read only by `npm run db:seed` to create the first owner account.
# Change the password after the first sign-in, then remove these values.
ADMIN_EMAIL="owner@noriva.sa"
ADMIN_PASSWORD=""
ADMIN_NAME="Noriva"

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph,
# the sitemap and the admin links inside inquiry emails.
NEXT_PUBLIC_SITE_URL="https://noriva.sa"

# ─── Email ───────────────────────────────────────────────────────────────────
# Fallback recipient for inquiries when none is set in Admin → Site settings.
CONTACT_EMAIL="hello@noriva.sa"

# SMTP. Leave SMTP_HOST empty to disable email entirely: inquiries are still
# stored and visible in Admin, they are simply not emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Envelope From. Defaults to SMTP_USER when empty.
SMTP_FROM=""
# Set to "true" for implicit TLS. Port 465 enables it automatically.
SMTP_SECURE="false"

# ─── File storage ────────────────────────────────────────────────────────────
# Directory for uploaded files, relative to the project root or absolute.
# Must be writable and must persist across deployments.
#   <dir>/public   media library, served at /media/*
#   <dir>/private  client inquiry attachments, admin-only
STORAGE_DIR="./storage"

# ─── Analytics (optional) ────────────────────────────────────────────────────
# Can also be set in Admin → SEO. Leave empty to load no tracking scripts.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
