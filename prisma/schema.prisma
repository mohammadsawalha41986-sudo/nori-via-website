generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EDITOR
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum InquiryStatus {
  NEW
  CONTACTED
  COMPLETED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

/// How the footer paints its background. IMAGE keeps a stored image on file
/// even while COLOR is selected, so switching back and forth costs nothing.
enum FooterBackground {
  COLOR
  IMAGE
}

/// Where a footer background image is anchored inside the footer box. Only the
/// focal point moves; the image always covers the box.
enum FooterBackgroundPosition {
  CENTER
  TOP
  BOTTOM
  LEFT
  RIGHT
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions AdminSession[]
  media    Media[]
}

model AdminSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Singleton row (id = "singleton") holding global site configuration.
model SiteSettings {
  id String @id @default("singleton")

  companyNameEn String @default("Noriva")
  companyNameAr String @default("نوريفا")
  taglineEn     String @default("Restaurant · Creative · Growth")
  taglineAr     String @default("مطاعم · إبداع · نمو")
  descriptionEn String @default("")
  descriptionAr String @default("")

  logoUrl        String?
  logoMarkUrl    String?
  /// Optional light/reversed artwork for dark backgrounds. When absent, the
  /// primary logo is placed on a light plate rather than being recoloured.
  logoInverseUrl String?
  faviconUrl     String?
  defaultOgImage String?

  inquiryEmail String @default("")
  contactEmail String @default("")
  phone        String @default("")
  whatsapp     String @default("")

  addressEn String @default("")
  addressAr String @default("")
  mapsUrl   String @default("")

  instagram String @default("")
  tiktok    String @default("")
  linkedin  String @default("")
  x         String @default("")
  youtube   String @default("")

  footerDescriptionEn String @default("")
  footerDescriptionAr String @default("")

  /// Footer backdrop. When the type is IMAGE and an image is set, it is drawn
  /// full-bleed behind an overlay; otherwise the colour is used, and an empty
  /// colour falls back to the brand's dark ink.
  footerBackgroundType     FooterBackground         @default(COLOR)
  footerBackgroundImage    String?
  footerBackgroundColor    String                   @default("")
  footerBackgroundPosition FooterBackgroundPosition @default(CENTER)

  /// Overlay drawn over a footer background image so the type stays readable.
  /// The opacity is a percentage; 0 shows the bare image, 100 hides it.
  footerOverlayColor   String @default("")
  footerOverlayOpacity Int    @default(80)
  copyrightEn          String @default("")
  copyrightAr          String @default("")

  seoTitleEn       String @default("")
  seoTitleAr       String @default("")
  seoDescriptionEn String @default("")
  seoDescriptionAr String @default("")

  gaId  String @default("")
  gtmId String @default("")

  updatedAt DateTime @updatedAt
}

/// Singleton row (id = "singleton") for editable homepage copy.
model HomepageContent {
  id String @id @default("singleton")

  heroEyebrowEn      String    @default("")
  heroEyebrowAr      String    @default("")
  heroHeadlineEn     String    @default("")
  heroHeadlineAr     String    @default("")
  heroSubtitleEn     String    @default("")
  heroSubtitleAr     String    @default("")
  heroPrimaryCtaEn   String    @default("")
  heroPrimaryCtaAr   String    @default("")
  heroSecondaryCtaEn String    @default("")
  heroSecondaryCtaAr String    @default("")
  heroMediaUrl       String?
  heroMediaKind      MediaKind @default(IMAGE)

  statementEn        String @default("")
  statementAr        String @default("")
  statementSupportEn String @default("")
  statementSupportAr String @default("")

  systemHeadlineEn String @default("")
  systemHeadlineAr String @default("")

  intelligenceHeadlineEn String @default("")
  intelligenceHeadlineAr String @default("")
  intelligenceBodyEn     String @default("")
  intelligenceBodyAr     String @default("")
  intelligenceItems      Json   @default("[]")

  featuredCaseStudyId String?

  /// "Questions that usually go unanswered" — the numbered split block whose
  /// answers are always visible. Its rows live in HomepageFaq (group NUMBERED).
  questionsEyebrowEn  String @default("")
  questionsEyebrowAr  String @default("")
  questionsHeadlineEn String @default("")
  questionsHeadlineAr String @default("")
  questionsBodyEn     String @default("")
  questionsBodyAr     String @default("")

  /// The collapsible FAQ block. Rows live in HomepageFaq (group ACCORDION).
  faqEyebrowEn  String @default("")
  faqEyebrowAr  String @default("")
  faqHeadlineEn String @default("")
  faqHeadlineAr String @default("")
  faqBodyEn     String @default("")
  faqBodyAr     String @default("")

  /// The services showcase: a grid of published services with one of them
  /// promoted to a large image card.
  servicesHeadlineEn String  @default("")
  servicesHeadlineAr String  @default("")
  servicesBodyEn     String  @default("")
  servicesBodyAr     String  @default("")
  featuredServiceId  String?

  /// The full-width image banner and its call to action.
  bannerEyebrowEn  String  @default("")
  bannerEyebrowAr  String  @default("")
  bannerHeadlineEn String  @default("")
  bannerHeadlineAr String  @default("")
  bannerBodyEn     String  @default("")
  bannerBodyAr     String  @default("")
  bannerCtaLabelEn String  @default("")
  bannerCtaLabelAr String  @default("")
  bannerCtaHref    String  @default("")
  bannerImageUrl   String?

  ctaHeadlineEn    String @default("")
  ctaHeadlineAr    String @default("")
  ctaDescriptionEn String @default("")
  ctaDescriptionAr String @default("")
  ctaLabelEn       String @default("")
  ctaLabelAr       String @default("")

  updatedAt DateTime @updatedAt
}

/// One of the four "Noriva System" storytelling stages on the homepage.
model SystemStage {
  id            String  @id @default(cuid())
  step          String
  titleEn       String
  titleAr       String
  descriptionEn String  @default("")
  descriptionAr String  @default("")
  services      Json    @default("[]")
  mediaUrl      String?
  order         Int     @default(0)
  visible       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Which homepage block a question belongs to. One table serves both because
/// the fields are identical; only the presentation differs.
enum HomepageFaqGroup {
  /// Numbered list with the answers always visible.
  NUMBERED
  /// Collapsible accordion.
  ACCORDION
}

/// A question shown on the homepage, in either of its two question blocks.
model HomepageFaq {
  id         String           @id @default(cuid())
  group      HomepageFaqGroup @default(ACCORDION)
  questionEn String
  questionAr String           @default("")
  answerEn   String           @default("")
  answerAr   String           @default("")
  order      Int              @default(0)
  visible    Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group, visible, order])
}

model ServiceCategory {
  id            String  @id @default(cuid())
  slug          String  @unique
  nameEn        String
  nameAr        String
  descriptionEn String  @default("")
  descriptionAr String  @default("")
  order         Int     @default(0)
  visible       Boolean @default(true)

  services Service[]
}

model Service {
  id     String @id @default(cuid())
  slug   String @unique
  nameEn String
  nameAr String

  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  summaryEn String @default("")
  summaryAr String @default("")

  heroHeadlineEn    String @default("")
  heroHeadlineAr    String @default("")
  heroDescriptionEn String @default("")
  heroDescriptionAr String @default("")

  whatWeDoEn     String @default("")
  whatWeDoAr     String @default("")
  whyItMattersEn String @default("")
  whyItMattersAr String @default("")
  approachEn     String @default("")
  approachAr     String @default("")

  deliverables Json @default("[]")
  process      Json @default("[]")
  benefits     Json @default("[]")
  faqs         Json @default("[]")

  /// Service-specific intake questions, asked when a visitor requests this
  /// service. Shape: { questions: IntakeQuestion[] } — see lib/intake.ts.
  intake Json @default("{}")

  featuredImage String?
  gallery       Json    @default("[]")

  seoTitleEn       String  @default("")
  seoTitleAr       String  @default("")
  seoDescriptionEn String  @default("")
  seoDescriptionAr String  @default("")
  ogImage          String?
  noindex          Boolean @default(false)

  status PublishStatus @default(DRAFT)
  order  Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects    ProjectService[]
  caseStudies CaseStudyService[]

  @@index([status, order])
}

model WorkCategory {
  id      String  @id @default(cuid())
  slug    String  @unique
  nameEn  String
  nameAr  String
  order   Int     @default(0)
  visible Boolean @default(true)

  projects Project[]
}

model Project {
  id      String @id @default(cuid())
  slug    String @unique
  titleEn String
  titleAr String

  client String @default("")

  categoryId String?
  category   WorkCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  descriptionEn String @default("")
  descriptionAr String @default("")

  heroMediaUrl  String?
  heroMediaKind MediaKind @default(IMAGE)
  gallery       Json      @default("[]")
  videos        Json      @default("[]")
  downloads     Json      @default("[]")

  year     Int?
  location String @default("")

  /// Only verified, real metrics. Never fabricated.
  results Json @default("[]")

  featured Boolean       @default(false)
  status   PublishStatus @default(DRAFT)
  order    Int           @default(0)

  seoTitleEn       String  @default("")
  seoTitleAr       String  @default("")
  seoDescriptionEn String  @default("")
  seoDescriptionAr String  @default("")
  ogImage          String?
  noindex          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services  ProjectService[]
  caseStudy CaseStudy?

  @@index([status, order])
}

model ProjectService {
  projectId String
  serviceId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
}

model CaseStudy {
  id      String @id @default(cuid())
  slug    String @unique
  titleEn String
  titleAr String

  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  challengeEn String @default("")
  challengeAr String @default("")
  strategyEn  String @default("")
  strategyAr  String @default("")
  ideaEn      String @default("")
  ideaAr      String @default("")
  creativeEn  String @default("")
  creativeAr  String @default("")
  campaignEn  String @default("")
  campaignAr  String @default("")
  resultEn    String @default("")
  resultAr    String @default("")
  outcomeEn   String @default("")
  outcomeAr   String @default("")

  /// Only verified metrics.
  metrics Json @default("[]")
  gallery Json @default("[]")
  videos  Json @default("[]")
  files   Json @default("[]")

  heroMediaUrl String?

  seoTitleEn       String  @default("")
  seoTitleAr       String  @default("")
  seoDescriptionEn String  @default("")
  seoDescriptionAr String  @default("")
  ogImage          String?
  noindex          Boolean @default(false)

  status PublishStatus @default(DRAFT)
  order  Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services CaseStudyService[]

  @@index([status, order])
}

model CaseStudyService {
  caseStudyId String
  serviceId   String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([caseStudyId, serviceId])
}

model InsightCategory {
  id      String  @id @default(cuid())
  slug    String  @unique
  nameEn  String
  nameAr  String
  order   Int     @default(0)
  visible Boolean @default(true)

  insights Insight[]
}

model Insight {
  id      String @id @default(cuid())
  slug    String @unique
  titleEn String
  titleAr String

  excerptEn String @default("")
  excerptAr String @default("")
  contentEn String @default("")
  contentAr String @default("")

  coverImage String?

  categoryId String?
  category   InsightCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags   Json   @default("[]")
  author String @default("")

  publishedAt DateTime?
  status      PublishStatus @default(DRAFT)

  seoTitleEn       String  @default("")
  seoTitleAr       String  @default("")
  seoDescriptionEn String  @default("")
  seoDescriptionAr String  @default("")
  ogImage          String?
  noindex          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

model Media {
  id       String    @id @default(cuid())
  filename String
  url      String
  kind     MediaKind @default(IMAGE)
  mimeType String
  size     Int
  width    Int?
  height   Int?
  altEn    String    @default("")
  altAr    String    @default("")

  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

model Statistic {
  id            String  @id @default(cuid())
  value         String
  labelEn       String
  labelAr       String
  descriptionEn String  @default("")
  descriptionAr String  @default("")
  visible       Boolean @default(false)
  order         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  company   String  @default("")
  role      String  @default("")
  quoteEn   String
  quoteAr   String  @default("")
  imageUrl  String?
  rating    Int?
  published Boolean @default(false)
  order     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NavigationItem {
  id       String  @id @default(cuid())
  labelEn  String
  labelAr  String
  href     String
  location String  @default("header")
  order    Int     @default(0)
  visible  Boolean @default(true)
  external Boolean @default(false)
}

model Page {
  id      String @id @default(cuid())
  key     String @unique
  titleEn String @default("")
  titleAr String @default("")
  bodyEn  String @default("")
  bodyAr  String @default("")

  /// Flexible per-page section content, edited from Admin.
  content Json @default("{}")

  seoTitleEn       String  @default("")
  seoTitleAr       String  @default("")
  seoDescriptionEn String  @default("")
  seoDescriptionAr String  @default("")
  canonical        String  @default("")
  ogImage          String?
  noindex          Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model ProjectInquiry {
  id String @id @default(cuid())

  name     String
  business String @default("")
  website  String @default("")
  social   String @default("")

  services Json @default("[]")
  goals    Json @default("[]")

  /// The service this request came through, when it started from a service
  /// page rather than the general Start a Project flow.
  serviceId   String?
  serviceSlug String  @default("")
  /// Answers to that service's intake questions: [{ key, label, value }].
  answers     Json    @default("[]")

  description String @default("")
  budget      String @default("")
  timeline    String @default("")

  email            String
  phone            String @default("")
  whatsapp         String @default("")
  preferredContact String @default("email")

  status InquiryStatus @default(NEW)
  notes  String        @default("")

  locale    String  @default("en")
  ip        String?
  userAgent String?

  emailSentToTeam  Boolean @default(false)
  confirmationSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments ProjectInquiryAttachment[]

  @@index([status, createdAt])
}

model ProjectInquiryAttachment {
  id        String @id @default(cuid())
  inquiryId String

  /// Original client filename, sanitised for display only.
  filename   String
  /// Randomised on-disk name; never derived from user input.
  storageKey String @unique
  mimeType   String
  size       Int

  createdAt DateTime @default(now())

  inquiry ProjectInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

model ContactMessage {
  id      String @id @default(cuid())
  name    String
  email   String
  phone   String @default("")
  subject String @default("")
  message String

  status InquiryStatus @default(NEW)
  locale String        @default("en")
  ip     String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String   @default("")
  locale    String   @default("en")
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

// ---------------------------------------------------------------------------
// Design system, contact channels, library, tools and content relationships.
// ---------------------------------------------------------------------------

enum ResourceType {
  EXCEL
  WORD
  PDF
  TEMPLATE
  GUIDE
  REPORT
}

/// Every entity that can be linked to any other entity through ContentLink.
enum ContentType {
  INSIGHT
  RESOURCE
  TOOL
  SERVICE
  CASE_STUDY
  PROJECT
  /// Editable CMS pages (Start Here, Restaurant Growth, About …) so an editor
  /// can surface tools, resources and articles on them without code.
  PAGE
}

/// Singleton row (id = "singleton") holding the editable brand design tokens.
/// Each column is a validated partial override of the CSS variable defaults in
/// `globals.css`, so an empty row renders exactly the shipped brand.
model DesignTokens {
  id String @id @default("singleton")

  /// { brand, brandDark, ink900, …} — hex values, validated before saving.
  colors     Json @default("{}")
  /// { sansFont, displayFont, arabicFont, baseSize, lineHeight, headingWeight, … }
  typography Json @default("{}")
  /// { radiusButton, radiusCard, radiusInput, containerWidth, spacingScale, … }
  shape      Json @default("{}")

  updatedAt DateTime @updatedAt
}

/// Social channels rendered in the footer and Organization JSON-LD. Replaces
/// the fixed SiteSettings columns, which stay as the fallback for existing data.
model SocialLink {
  id       String  @id @default(cuid())
  platform String
  labelEn  String  @default("")
  labelAr  String  @default("")
  url      String
  enabled  Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

/// Floating contact buttons (WhatsApp, phone, email, custom link).
model FloatingAction {
  id      String  @id @default(cuid())
  kind    String  @default("whatsapp")
  labelEn String  @default("")
  labelAr String  @default("")
  value   String  @default("")
  enabled Boolean @default(true)
  order   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

model ResourceCategory {
  id            String  @id @default(cuid())
  slug          String  @unique
  nameEn        String
  nameAr        String
  descriptionEn String  @default("")
  descriptionAr String  @default("")
  order         Int     @default(0)
  visible       Boolean @default(true)

  resources Resource[]
}

/// A downloadable asset in the Library: spreadsheet, document, PDF or guide.
model Resource {
  id      String @id @default(cuid())
  slug    String @unique
  titleEn String
  titleAr String @default("")

  summaryEn     String @default("")
  summaryAr     String @default("")
  descriptionEn String @default("")
  descriptionAr String @default("")

  type       ResourceType      @default(PDF)
  categoryId String?
  category   ResourceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags Json @default("[]")

  /// Randomised private storage key; never derived from the uploaded filename.
  fileKey     String?
  fileName    String  @default("")
  fileMime    String  @default("")
  fileSize    Int     @default(0)
  /// Used instead of an upload when the asset is hosted elsewhere.
  externalUrl String  @default("")

  thumbnail String?

  /// Localised bullet lists: what the file contains, and who it is for.
  includes Json @default("[]")
  audience Json @default("[]")

  downloadCount Int     @default(0)
  featured      Boolean @default(false)

  publishedAt DateTime?
  status      PublishStatus @default(DRAFT)
  order       Int           @default(0)

  seoTitleEn       String  @default("")
  seoTitleAr       String  @default("")
  seoDescriptionEn String  @default("")
  seoDescriptionAr String  @default("")
  ogImage          String?
  noindex          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
  @@index([type, status])
}

/// An interactive calculator/estimator. The inputs, formulas and outputs are
/// authored in Admin as data, so new tools need no code change.
model Tool {
  id     String @id @default(cuid())
  slug   String @unique
  nameEn String
  nameAr String @default("")

  summaryEn     String @default("")
  summaryAr     String @default("")
  descriptionEn String @default("")
  descriptionAr String @default("")
  purposeEn     String @default("")
  purposeAr     String @default("")

  /// { inputs: ToolInput[], outputs: ToolOutput[], notesEn, notesAr }
  config Json @default("{}")

  thumbnail String?

  featured Boolean       @default(false)
  status   PublishStatus @default(DRAFT)
  order    Int           @default(0)

  seoTitleEn       String  @default("")
  seoTitleAr       String  @default("")
  seoDescriptionEn String  @default("")
  seoDescriptionAr String  @default("")
  ogImage          String?
  noindex          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
}

/// Polymorphic relationship between any two pieces of content. Links are read
/// in both directions, so an article attached to a tool also surfaces on that
/// tool. Rows are removed explicitly when either side is deleted, since a
/// polymorphic edge cannot carry a foreign key.
model ContentLink {
  id       String      @id @default(cuid())
  fromType ContentType
  fromId   String
  toType   ContentType
  toId     String
  order    Int         @default(0)

  createdAt DateTime @default(now())

  @@unique([fromType, fromId, toType, toId])
  @@index([fromType, fromId])
  @@index([toType, toId])
}
