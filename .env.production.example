# ==============================================================================
# NORIVA — PRODUCTION ENVIRONMENT (Hostinger)
# ==============================================================================
# Template only. Never commit a filled-in copy: real values belong in the
# Hostinger environment-variable panel, not in the repository.
#
# This application uses exactly the variables below. There are no others.
# Verified against the source: `src/lib/env.ts`, `prisma/schema.prisma`,
# `src/lib/auth.ts`, `src/lib/storage.ts` and `prisma/seed.ts`.
#
# NOT USED by this application — do not add them:
#   REDIS_URL / any Redis or cache variable  (rate limiting is PostgreSQL-backed)
#   S3 / R2 / Cloudinary / Supabase storage  (uploads go to the local filesystem)
#   NEXTAUTH_URL / NEXTAUTH_SECRET           (auth is a custom implementation)
#   NODE_ENV                                 (set automatically by `next start`)
# ==============================================================================


# ── 1. REQUIRED — the app will not work correctly without these ───────────────

# Canonical public origin. No trailing slash, https in production.
# Used for canonical URLs, hreflang, Open Graph, the sitemap, and the Admin
# links inside inquiry notification emails. A wrong value here silently
# produces wrong canonical tags and broken email links.
NEXT_PUBLIC_SITE_URL="https://noriva.sa"


# ── 2. REQUIRED FOR DATABASE ──────────────────────────────────────────────────

# PostgreSQL connection string, read by Prisma via `env("DATABASE_URL")`.
#
# Required at RUNTIME and for `prisma migrate deploy`.
# NOT required for `next build` — no CMS page is prerendered at build time.
#
# Add ?sslmode=require when the database is reached over a public network.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"


# ── 3. REQUIRED FOR AUTHENTICATION ────────────────────────────────────────────

# Signs the admin session cookie (HS256, via `jose`).
# Must be at least 32 characters or the app refuses to create a session.
# Generate a fresh one for production:  openssl rand -base64 48
# Rotating this value signs every admin out; it does not affect content.
AUTH_SECRET=""


# ── 4. REQUIRED FOR FILE STORAGE ──────────────────────────────────────────────

# Absolute path to a writable directory that PERSISTS ACROSS DEPLOYMENTS.
# Uploads are written to the local filesystem — there is no object storage.
# If this points inside the deploy folder, every redeploy destroys all uploads.
#
#   $STORAGE_DIR/public   media library, served publicly at /media/*
#   $STORAGE_DIR/private  client inquiry attachments, admin-only, never public
#
# Back this directory up together with the database.
STORAGE_DIR="/home/USER/noriva-storage"


# ── 5. EMAIL — required for inquiry notifications to be delivered ─────────────
# Without these the site still works and inquiries are still saved and visible
# in Admin; they are simply not emailed. Nothing is lost.

# Fallback recipient, used when no inquiry address is set in Admin → Site
# settings. The Admin value takes precedence.
CONTACT_EMAIL="hello@noriva.sa"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Envelope From address. Falls back to SMTP_USER when empty.
# Use an address on a domain whose SPF/DKIM you control, or mail will be spam-filed.
SMTP_FROM="website@noriva.sa"
# "true" only for implicit TLS. Port 465 turns this on automatically.
SMTP_SECURE="false"


# ── 6. OPTIONAL — analytics ───────────────────────────────────────────────────
# Can also be set in Admin → SEO, which takes precedence.
# Leave empty and no tracking script is loaded at all.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""


# ── 7. SET ONCE, THEN REMOVE — first admin account ────────────────────────────
# Read ONLY by `npm run db:seed`. Never read by the running application.
# Set them, run the seed once, sign in, change the password in Admin, then
# DELETE these three variables from the Hostinger panel.
ADMIN_EMAIL="owner@noriva.sa"
ADMIN_PASSWORD=""
ADMIN_NAME="Noriva"


# ── 8. PLATFORM-PROVIDED — do not set by hand unless Hostinger requires it ────
# PORT is read by `next start`; Hostinger normally injects it. Only set it if
# the panel requires an explicit port.
# PORT="3000"
